{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ilara Finanzas",
  "version": "3.1.0",
  "identifier": "com.ilara.finanzas",
  "build": {
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ilara Finanzas",
        "width": 1180,
        "height": 800,
        "minWidth": 320,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Finance",
    "shortDescription": "Finanzas personales y del hogar",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
