{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ilara Finanzas",
  "version": "3.9.9+13",
  "identifier": "com.ilara.finanzas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ilara Finanzas",
        "width": 1280,
        "height": 840,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://dolarapi.com https://api.bluelytics.com.ar https://api.github.com https://oauth2.googleapis.com https://www.googleapis.com https://accounts.google.com; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Finance",
    "shortDescription": "Finanzas personales y del hogar",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
